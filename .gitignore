# Secrets & credentials — never commit
config.toml
credentials.json
token.json
*.env
.env

# Local runtime state
state.json
*.log

# Hand-labelled cases for scripts/bench_suggest.py. Real merchant names — and
# the repo is public — so they stay on the box that has the data.
bench-cases.local.json

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Web app local dev
web/dev.db

# Onboarding screen recordings. Kept out of git on purpose: the repo is public
# and video is permanent weight in the history. Deploy them by rsync (see
# DEPLOYMENT.md); every slot renders nothing when the file is absent.
web/app/static/clips/*
!web/app/static/clips/.gitkeep

# Locally installed agent skills
.agents/
.claude/skills/
skills-lock.json
