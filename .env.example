# Copy to .env on the VPS and fill in. .env is git-ignored.
#
# With BUDGET_ENV=production the app refuses to start unless every secret below
# is set, at least 32 characters, and not a development default — and unless
# BUDGET_BASE_URL is https. Generate each one with: openssl rand -hex 32
BUDGET_ENV=production
POSTGRES_PASSWORD=
BUDGET_WEBHOOK_SECRET=          # long random string; part of the Postmark webhook URL
BUDGET_FERNET_KEY=              # REQUIRED in prod (email bodies at rest): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUDGET_INBOUND_DOMAIN=in.yourdomain.do
BUDGET_USER_EMAIL=jabner0703@gmail.com
BUDGET_TELEGRAM_TOKEN=
BUDGET_TELEGRAM_BOT_USERNAME=    # bot @username without @ (else discovered via getMe)
BUDGET_TELEGRAM_WEBHOOK_SECRET=  # REQUIRED in prod; guards the Telegram webhook URL; set setWebhook to match

# --- Auth (Phase 2) ---
BUDGET_SESSION_SECRET=          # long random string; signs session cookies + verify tokens. REQUIRED in prod.
BUDGET_BASE_URL=https://yourdomain.do   # absolute origin used in verification-email links
BUDGET_POSTMARK_TOKEN=          # Postmark server token for outbound mail; if empty, links are logged instead
BUDGET_FROM_EMAIL=no-reply@yourdomain.do
BUDGET_BOOTSTRAP_PASSWORD=      # optional: sets a password on the seeded dev account so you can log in
